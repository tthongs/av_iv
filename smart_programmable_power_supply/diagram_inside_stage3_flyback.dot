digraph InsideStage3Flyback {
    graph [
        rankdir=LR,
        bgcolor="#FFFFFF",
        compound=true,
        fontname="Helvetica, Arial, sans-serif",
        fontsize=12,
        nodesep=0.40,
        ranksep=0.65,
        pad="0.25,0.25",
        splines=true
    ];

    node [
        fontname="Helvetica, Arial, sans-serif",
        fontsize=9.5,
        shape=box,
        style="filled,rounded",
        margin="0.16,0.12",
        penwidth=1.6
    ];

    edge [
        fontname="Helvetica, Arial, sans-serif",
        fontsize=8.5,
        penwidth=2.0,
        arrowsize=0.8
    ];

    subgraph cluster_pri_flyback {
        label = "PRIMARY HOT DOMAIN (High-Voltage Switching)";
        style = "filled,rounded";
        fillcolor = "#FFF8E1";
        color = "#F57F17";
        penwidth = 1.6;

        hvdc_in [
            label = <<table border="0" cellborder="0" cellspacing="2">
                <tr><td><b>+HVDC BUS IN</b></td></tr>
                <tr><td><font color="#BF360C">+120V to +375V DC</font></td></tr>
                <hr/>
                <tr><td align="left">• From Stage 2 Bulk Cap</td></tr>
            </table>>,
            fillcolor = "#FFE0B2",
            color = "#E65100"
        ];

        rcd_snubber [
            label = <<table border="0" cellborder="0" cellspacing="2">
                <tr><td><b>RCD SNUBBER CLAMP</b></td></tr>
                <tr><td><font color="#B71C1C">D_snub + R_snub + C_snub</font></td></tr>
                <hr/>
                <tr><td align="left">• US1M Ultra-Fast Diode</td></tr>
                <tr><td align="left">• 1nF 1kV + 68kΩ 2W</td></tr>
                <tr><td align="left">• Clamps leakage &lt; 650V</td></tr>
            </table>>,
            fillcolor = "#FFCDD2",
            color = "#B71C1C"
        ];

        pri_winding [
            label = <<table border="0" cellborder="0" cellspacing="2">
                <tr><td><b>TX1 PRIMARY (36T)</b></td></tr>
                <tr><td><font color="#E65100">PQ26/20 (3C95 Ferrite)</font></td></tr>
                <hr/>
                <tr><td align="left">• Primary Inductance: <b>220µH</b></td></tr>
                <tr><td align="left">• Peak Current: <b>I_pk = 2.96A</b></td></tr>
                <tr><td align="left">• Peak Flux: <b>B_max = 0.28T</b></td></tr>
            </table>>,
            fillcolor = "#FFE082",
            color = "#F57F17"
        ];

        pri_mosfet [
            label = <<table border="0" cellborder="0" cellspacing="2">
                <tr><td><b>PRIMARY MOSFET (Q1)</b></td></tr>
                <tr><td><font color="#1565C0">Infineon IPB80R290P7</font></td></tr>
                <hr/>
                <tr><td align="left">• 800V Superjunction</td></tr>
                <tr><td align="left">• R_DS(on) = 0.29Ω (D2PAK)</td></tr>
                <tr><td align="left">• Quasi-resonant valley switch</td></tr>
            </table>>,
            fillcolor = "#BBDEFB",
            color = "#1565C0"
        ];

        qr_controller [
            label = <<table border="0" cellborder="0" cellspacing="2">
                <tr><td><b>QR FLYBACK IC (U1)</b></td></tr>
                <tr><td><font color="#2E7D32">TI UCC28740DR (SOIC-7)</font></td></tr>
                <hr/>
                <tr><td align="left">• Valley switching detector</td></tr>
                <tr><td align="left">• Auxiliary winding ZCD</td></tr>
                <tr><td align="left">• Optocoupler feedback pin</td></tr>
            </table>>,
            fillcolor = "#C8E6C9",
            color = "#2E7D32"
        ];

        aux_winding [
            label = <<table border="0" cellborder="0" cellspacing="2">
                <tr><td><b>AUX WINDING (6T)</b></td></tr>
                <tr><td><font color="#6A1B9A">+14.0V Bias &amp; Demag</font></td></tr>
                <hr/>
                <tr><td align="left">• Powers UCC28740 VCC</td></tr>
                <tr><td align="left">• ZCD zero-cross detection</td></tr>
            </table>>,
            fillcolor = "#E1BEE7",
            color = "#6A1B9A"
        ];
    }

    subgraph cluster_sec_flyback {
        label = "SECONDARY COLD DOMAIN (Touch-Safe SELV)";
        style = "filled,rounded";
        fillcolor = "#E8F5E9";
        color = "#2E7D32";
        penwidth = 1.6;

        sec_winding [
            label = <<table border="0" cellborder="0" cellspacing="2">
                <tr><td><b>TX1 SECONDARY (6T)</b></td></tr>
                <tr><td><font color="#1B5E20">Furukawa TEX-E Wire</font></td></tr>
                <hr/>
                <tr><td align="left">• Triple-insulated wire</td></tr>
                <tr><td align="left">• Turns ratio Np:Ns = 6:1</td></tr>
                <tr><td align="left">• ⚡ 3000V RMS Proof</td></tr>
            </table>>,
            fillcolor = "#A5D6A7",
            color = "#1B5E20"
        ];

        sync_rectifier [
            label = <<table border="0" cellborder="0" cellspacing="2">
                <tr><td><b>SYNC RECTIFIER (Q_SR)</b></td></tr>
                <tr><td><font color="#00695C">MP6908 + BSC052N06NS</font></td></tr>
                <hr/>
                <tr><td align="left">• 60V, 5.2mΩ SuperSO8</td></tr>
                <tr><td align="left">• Eliminates diode 0.55V drop</td></tr>
                <tr><td align="left">• Saves ~1.65W dissipation</td></tr>
            </table>>,
            fillcolor = "#B2DFDB",
            color = "#00695C"
        ];

        sec_filter [
            label = <<table border="0" cellborder="0" cellspacing="2">
                <tr><td><b>LC PI OUTPUT FILTER</b></td></tr>
                <tr><td><font color="#1565C0">470µF Polymer + 2.2µH</font></td></tr>
                <hr/>
                <tr><td align="left">• Ultra-low ESR bank</td></tr>
                <tr><td align="left">• Attenuates 80kHz ripple</td></tr>
            </table>>,
            fillcolor = "#E3F2FD",
            color = "#1565C0"
        ];

        tl431_opto [
            label = <<table border="0" cellborder="0" cellspacing="2">
                <tr><td><b>ISOLATED FEEDBACK</b></td></tr>
                <tr><td><font color="#4E342E">TL431 + Opto EL817</font></td></tr>
                <hr/>
                <tr><td align="left">• Precision 2.495V shunt</td></tr>
                <tr><td align="left">• 5000V RMS Optocoupler</td></tr>
                <tr><td align="left">• Regulates +24.0V ± 1.0%</td></tr>
            </table>>,
            fillcolor = "#D7CCC8",
            color = "#4E342E"
        ];

        bus_24v [
            label = <<table border="0" cellborder="0" cellspacing="2">
                <tr><td><b>INTERMEDIATE BUS OUT</b></td></tr>
                <tr><td><font color="#004D40"><b>+24.0V DC (72W Continuous)</b></font></td></tr>
                <hr/>
                <tr><td align="left">• Ripple &lt; 50mV pk-pk</td></tr>
                <tr><td align="left">• Feeds Stage 4 Buck-Boost</td></tr>
            </table>>,
            fillcolor = "#80CBC4",
            color = "#004D40"
        ];
    }

    hvdc_in -> pri_winding [label="HVDC Supply"];
    pri_winding -> rcd_snubber [label="Snubber Clamp", style=dashed, color="#B71C1C"];
    pri_winding -> pri_mosfet [label="Switch Drain"];
    qr_controller -> pri_mosfet [label="Gate Drive PWM"];
    aux_winding -> qr_controller [label="ZCD & VCC"];

    pri_winding -> sec_winding [label="⚡ 3000V Isolation Barrier", penwidth=3.0, color="#D32F2F", style=bold];
    sec_winding -> sync_rectifier [label="HF AC Pulses"];
    sync_rectifier -> sec_filter [label="Rectified DC"];
    sec_filter -> bus_24v [label="+24V Rail", color="#004D40", penwidth=2.4];
    bus_24v -> tl431_opto [label="Sense +24V"];
    tl431_opto -> qr_controller [label="Isolated Feedback", style=dashed, color="#6A1B9A"];
}